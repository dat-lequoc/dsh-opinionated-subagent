{
  "name": "dsh-subagent-model",
  "version": "0.1.0",
  "description": "A subagent tool that forces each child onto an explicitly chosen provider/model and reasoning effort instead of inheriting the parent's route",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./spawn": "./lib/spawn.js",
    "./policy": "./lib/policy.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "subagent",
    "model",
    "reasoning-effort"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
